{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/app.html" },
    { "source": "/sb/:path*", "destination": "https://fitness-dubai-fewer-dosage.trycloudflare.com/sb/:path*" },
    { "source": "/cerebro/:path*", "destination": "https://fitness-dubai-fewer-dosage.trycloudflare.com/cerebro/:path*" },
    { "source": "/voz/:path*", "destination": "https://fitness-dubai-fewer-dosage.trycloudflare.com/voz/:path*" }
  ],
  "headers": [
    { "source": "/(.*)\\.(js|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}