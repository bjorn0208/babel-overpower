  }
  const mascaras = { saleDate: mascaraData, setupPrice: mascaraPreco, whatsapp: mascaraZap };
  for (const k of Object.keys(mascaras)) campos[k].addEventListener('input', (e) => {
    const el = e.target; const apagando = e.inputType && e.inputType.startsWith('delete');
    if (apagando && k !== 'setupPrice' && !/\d$/.test(el.value)) return;            // deixa apagar a pontuação sem reformatar por cima
    el.value = mascaras[k](el.value);
  });

  /* ---------- validação local: mensagem que diz o que fazer ---------- */
  const hoje = new Date();
  const dataValida = (v) => { const m = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(v); if (!m) return false; const d = new Date(+m[3], +m[2] - 1, +m[1]); return d.getFullYear() === +m[3] && d.getMonth() === +m[2] - 1 && d.getDate() === +m[1] && d <= hoje && +m[3] >= 2020; };
  const MSG = {
    sellerName: 'Digite o nome do vendedor ou parceiro.', saleDate: 'Digite a data da venda no formato dd/mm/aaaa (até hoje).', setupPrice: 'Digite o preço da venda em reais.',
    plan: 'Escolha o plano mensal.', clientName: 'Digite o nome do cliente.',
    companyName: 'Digite o nome da empresa do cliente.', niche: 'Conte o nicho da empresa.', whatsapp: 'Digite um WhatsApp válido.', email: 'Digite um e-mail válido.',
  };
  const valido = {
    sellerName: (v) => v.trim().length >= 2, saleDate: dataValida, setupPrice: (v) => parseInt(digitos(v) || '0', 10) > 0,
    plan: (v) => PLANOS.some((p) => p.id === v),
    clientName: (v) => v.trim().length >= 2, companyName: (v) => v.trim().length >= 2, niche: (v) => v.trim().length >= 2,
    whatsapp: (v) => { const d = digitos(v); return d.length >= 10 && d.length <= 13; }, email: (v) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v),
  };
  function marcar(k, erro) { campos[k].setAttribute('aria-invalid', erro ? 'true' : 'false'); $(k + '-erro').textContent = erro ? MSG[k] : ''; }
  function validar() {
    let primeiro = null;
    for (const k of CAMPOS) { const ok = valido[k](campos[k].value); marcar(k, !ok); if (!ok && !primeiro) primeiro = campos[k]; }
    if (primeiro) { primeiro.focus({ preventScroll: false }); anunciar('Há um campo para corrigir: ' + $(primeiro.id + '-erro').textContent); }
    return !primeiro;
  }
  for (const k of CAMPOS) campos[k].addEventListener(k === 'plan' ? 'change' : 'input', () => { if (campos[k].getAttribute('aria-invalid') === 'true' && valido[k](campos[k].value)) marcar(k, false); });

  /* ---------- o Core responde ---------- */
  let coreEstado = 'idle';
  function coreIr(s) { coreEstado = s; core.setAttribute('data-core', s); }
  function corePulsar() { const c = core.querySelector('.casca'); c.classList.remove('pulsa'); void c.offsetWidth; c.classList.add('pulsa'); }
  function coreVarrer() { const l = core.querySelector('.leitura'); l.classList.remove('varre'); void l.offsetWidth; l.classList.add('varre'); }
  form.addEventListener('focusin', (e) => { if (['hero', 'success', 'submitting'].includes(estado)) return; coreIr('listening'); if (e.target.closest('.campo')) html.classList.add('ouvindo'); });
  form.addEventListener('focusout', () => { if (coreEstado === 'listening') coreIr('idle'); html.classList.remove('ouvindo'); });

  /* ---------- posição de apoio do Core ---------- */
  const slotHero = $('slot-hero'), slotDock = $('slot-dock');
  function posicionarCore() {
    const a = slotHero.getBoundingClientRect(), b = slotDock.getBoundingClientRect();
    if (!a.width || !b.width) return;
    core.style.setProperty('--dock-x', (b.left + b.width / 2 - (a.left + a.width / 2)) + 'px');
    core.style.setProperty('--dock-y', (b.top + b.height / 2 - (a.top + a.height / 2)) + 'px');
    core.style.setProperty('--dock-s', (b.width / a.width).toFixed(3));
    sinal.style.setProperty('--sig-w', sinal.getBoundingClientRect().width + 'px');
  }
  addEventListener('resize', posicionarCore);

  /* ---------- a máquina ---------- */
  let estado = 'hero';
  const TRANSICOES = { hero: ['identity'], identity: ['submitting'], submitting: ['success', 'error'], error: ['submitting'], success: [] };
  const STATUS = { hero: 'PRONTO', identity: 'EM CURSO', submitting: 'REGISTRANDO', error: 'AGUARDANDO', success: 'REGISTRADA' };
  function anunciar(t) { estadoEl.textContent = ''; setTimeout(() => { estadoEl.textContent = t; }, 30); }
  const espera = (t) => new Promise((r) => setTimeout(r, html.hasAttribute('data-seeking') || REDUZ ? 0 : t));

  function aplicar(novo) {
    estado = novo; html.setAttribute('data-state', novo); statusInstr.textContent = STATUS[novo];
    const noProtocolo = ['identity', 'submitting', 'error'].includes(novo);
    protocolo.hidden = !noProtocolo; registrado.hidden = novo !== 'success';
    hero.hidden = novo !== 'hero'; hero.classList.remove('saindo');
    if (noProtocolo) {
      sinal.style.setProperty('--sig-fill', novo === 'submitting' ? '1' : '0');
      sinal.querySelector('.sinal-no-1').classList.add('vivo'); sinal.querySelector('.sinal-no-2').classList.toggle('vivo', novo === 'submitting');
      const enviando = novo === 'submitting';
      for (const k of CAMPOS) campos[k].disabled = enviando;
      confirmar.setAttribute('aria-busy', enviando ? 'true' : 'false'); confirmar.disabled = enviando;
      confirmarTexto.textContent = enviando ? 'PREPARANDO MENSAGEM' : (novo === 'error' ? 'TENTAR NOVAMENTE' : 'REGISTRAR VENDA');
      erroEnvio.hidden = novo !== 'error';
    }
    if (novo === 'success') sinal.style.setProperty('--sig-fill', '1');
  }

  /** ir(novo): a única porta de mudança de estado. Devolve false (nunca lança) para transição proibida. */
  async function ir(novo, opc) {
    opc = opc || {};
    if (!TRANSICOES[estado] || !TRANSICOES[estado].includes(novo)) { if (!opc.forcar) return false; }
    if (novo === 'success' && !opc.confirmado) return false;              // sucesso exige a resposta real do servidor
    const rapido = opc.rapido || html.hasAttribute('data-seeking') || REDUZ;
    if (estado === 'hero' && !rapido) { hero.classList.add('saindo'); await espera(T.fast); }
    if (novo === 'identity' && estado !== 'error') { coreIr('processing'); corePulsar(); coreVarrer(); }
    if (estado === 'identity' && novo === 'submitting' && !rapido) { sinal.classList.add('viajando'); setTimeout(() => sinal.classList.remove('viajando'), T.scene); }
    const alvo = novo === 'success' ? registrado : protocolo;
    const entrando = (estado === 'hero' || novo === 'success') && !rapido;
    if (entrando) alvo.classList.add('entrando');
    aplicar(novo);
    posicionarCore();
    if (entrando) { void alvo.offsetWidth; alvo.classList.remove('entrando'); }
    if (novo === 'identity') { if (!TOQUE) setTimeout(() => campos.sellerName.focus({ preventScroll: true }), rapido ? 0 : T.scene); anunciar('Registro de venda. Preencha os dados da venda e do cliente.'); setTimeout(() => { if (coreEstado === 'processing') coreIr('idle'); }, T.scene); }
    if (novo === 'submitting') { coreIr('processing'); corePulsar(); anunciar('Registrando a venda.'); }
    if (novo === 'error') { coreIr('error'); setTimeout(() => coreIr('idle'), T.slow); anunciar('Não conseguimos registrar a venda agora. Seus dados continuam aqui. Tente novamente.'); setTimeout(() => confirmar.focus({ preventScroll: true }), 0); }
    if (novo === 'success') { coreIr('complete'); anunciar('Venda registrada. A conta do cliente começa daqui.'); setTimeout(() => $('registrado-titulo').focus({ preventScroll: true }), rapido ? 0 : T.slow); }
    return true;
  }

  /* ---------- ações ---------- */
  $('iniciar').addEventListener('click', () => ir('identity'));
  form.addEventListener('submit', (e) => { e.preventDefault(); if (estado === 'identity' || estado === 'error') { if (validar()) enviar(); } });

  /* o payload é JSON: campos de texto normalizados, sem arquivo (24/09); o contrato (dados/contrato.json) lista cada chave */
  const submissionId = (crypto.randomUUID ? crypto.randomUUID() : (Date.now().toString(16) + '-' + Math.random().toString(16).slice(2, 10)));
  function isoData(v) { const m = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(v); return m ? `${m[3]}-${m[2]}-${m[1]}` : ''; }
  function payload() {
    return {
      sellerName: campos.sellerName.value.trim(),
      saleDate: isoData(campos.saleDate.value),                                 // yyyy-mm-dd (a tela mostra dd/mm/aaaa)
      setupCentavos: String(parseInt(digitos(campos.setupPrice.value) || '0', 10)),   // inteiro em centavos: sem ambiguidade de vírgula
      plan: campos.plan.value,
      clientName: campos.clientName.value.trim(), companyName: campos.companyName.value.trim(), niche: campos.niche.value.trim(),
      whatsapp: campos.whatsapp.value.trim(), email: campos.email.value.trim(),
      website: $('website').value || '',
      createdAt: new Date().toISOString(), submissionId: submissionId, consentText: $('lgpd').textContent.trim(),
    };
  }
  let enviando = false;
  /* ---------- envio ao servidor (24/09) ----------
     Sucesso só depois de uma resposta 2xx de verdade (a guarda de `ir('success')` sempre esperou por isto).
     Rede caiu, demorou mais de 15 s, 5xx ou 429: tenta de novo, até 3 vezes. Outro 4xx: não insiste.
     O `submissionId` é o mesmo em todas as tentativas e também no "TENTAR NOVAMENTE": o servidor
     deduplica por ele, então repetir nunca vira dois registros. */
  async function entregar(corpo) {
    if (!ENDPOINT) return false;
    const json = JSON.stringify(corpo);
    for (let tentativa = 1; tentativa <= 3; tentativa++) {
      const ctrl = typeof AbortController === 'function' ? new AbortController() : null;
      const prazo = ctrl ? setTimeout(() => ctrl.abort(), 15000) : 0;
      try {
        const r = await fetch(ENDPOINT, { method: 'POST', headers: { 'content-type': 'application/json' }, body: json, credentials: 'omit', cache: 'no-store', signal: ctrl ? ctrl.signal : undefined });
        if (r.ok) return true;
        if (r.status >= 400 && r.status < 500 && r.status !== 408 && r.status !== 429) return false;
      } catch (e) { /* rede caiu ou passou do prazo: tenta de novo */ }
      finally { clearTimeout(prazo); }
      if (tentativa < 3) await espera(700 * tentativa);
    }
    return false;
  }

  async function enviar() {
    if (enviando) return false;
    if ($('website').value) return false;
    enviando = true;
    if (!(await ir('submitting'))) { enviando = false; return false; }
    await espera(T.slow);
    if (!(await entregar(payload()))) { enviando = false; await ir('error'); return false; }
    enviando = false;
    return ir('success', { confirmado: true });
  }

  /* ---------- ponteiro: só pointer fine, sem movimento reduzido, fora do registro ---------- */
  if (matchMedia('(pointer: fine)').matches && !REDUZ && !FIM) {
    let tx = 0, ty = 0, cx = 0, cy = 0, gx = innerWidth / 2, gy = innerHeight / 2, ggx = gx, ggy = gy, rodando = false;
    const passo = () => {
      cx += (tx - cx) * .08; cy += (ty - cy) * .08; ggx += (gx - ggx) * .12; ggy += (gy - ggy) * .12;
      core.style.setProperty('--tilt-x', cx.toFixed(2) + 'deg'); core.style.setProperty('--tilt-y', cy.toFixed(2) + 'deg');
      const b = $('brilho'); b.style.setProperty('--gx', ggx.toFixed(0) + 'px'); b.style.setProperty('--gy', ggy.toFixed(0) + 'px');
      if (Math.abs(tx - cx) < .01 && Math.abs(ty - cy) < .01 && Math.abs(gx - ggx) < .5 && Math.abs(gy - ggy) < .5) { rodando = false; return; }
      requestAnimationFrame(passo);
    };
    const acorda = () => { if (!rodando) { rodando = true; requestAnimationFrame(passo); } };
    addEventListener('pointermove', (e) => { if (estado === 'success') return; html.classList.add('ponteiro'); tx = Math.max(-4, Math.min(4, ((e.clientY / innerHeight) - .5) * -6)); ty = Math.max(-5, Math.min(5, ((e.clientX / innerWidth) - .5) * 8)); gx = e.clientX; gy = e.clientY; acorda(); }, { passive: true });
    addEventListener('pointerleave', () => { tx = 0; ty = 0; acorda(); });
    document.addEventListener('visibilitychange', () => { if (document.hidden) { tx = 0; ty = 0; html.classList.remove('ponteiro'); } });
  }

  /* ---------- a régua: seek por estado; o registro sem pedido só existe em modo régua ---------- */
  function seek(t) {
    const i = Math.max(0, Math.min(2, Math.floor(Number(t) || 0)));
    const alvo = ['hero', 'identity', 'success'][i];
    if (alvo === 'success' && !MODO_REGUA) return false;
    html.setAttribute('data-seeking', '');
    aplicar(alvo); coreIr(alvo === 'success' ? 'complete' : 'idle');
    posicionarCore();
    void document.body.offsetWidth;
    requestAnimationFrame(() => html.removeAttribute('data-seeking'));
    return true;
  }
  window.__x = { seek, ir: (n, o) => ir(n, o), estado: () => ({ estado, core: coreEstado, endpoint: !!ENDPOINT, modoRegua: MODO_REGUA, reduz: REDUZ, planos: PLANOS.length }) };
  window.__cenas = { n: 3, seek, pontos: [0.5, 1.5, 2.5] };

  posicionarCore();
  if (FIM) seek(2);
  else if (html.classList.contains('abrindo')) {
    coreIr('access'); setTimeout(coreVarrer, 900);
    setTimeout(() => { html.classList.remove('abrindo'); if (coreEstado === 'access') coreIr('idle'); }, 1700);
  }
  document.fonts && document.fonts.ready.then(posicionarCore);
})();</script>
